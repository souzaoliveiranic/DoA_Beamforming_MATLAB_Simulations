% =======================================================================
%% Funções auxiliares
% =======================================================================


function P = uca_positions(uca)
    % Retorna P = Mx3 (x,y,z) em metros
    
    M = uca.NumElements;
    R = uca.Radius;
    
    phi0 = uca.AngleOffset;
    
    % Tenta ser robusto: se parecer graus, converte pra rad
    if abs(phi0) > 2*pi
        phi0 = deg2rad(phi0);
    end
    
    phi = phi0 + (0:M-1).' * (2*pi/M);
    
    P = [R*cos(phi), R*sin(phi), zeros(M,1)];
end



function Ctx = compute_Ctx_emf(fc, M, R, Z0, antenna_type, L_lambda)
    % Calcula a matriz de acoplamento mutuo de recepcao para UCA
    % usando o metodo EMF (Induced EMF Method) - conforme slide 43.
    %
    %   Ctx(i,i) = 1
    %   Ctx(i,j) = -Zt_ij / Z_L    (i ~= j)
    %
    % onde Zt_ij eh a impedancia mutua de recepcao entre elementos i e j,
    % calculada analiticamente para dipolos paralelos lado a lado.
    %
    % Entradas:
    %   fc           - frequencia de operacao (Hz)
    %   M            - numero de elementos
    %   R            - raio do UCA (metros)
    %   Z0           - impedancia de carga (Ohms, tipicamente 50)
    %   antenna_type - 'dipole' ou 'monopole'
    %   L_lambda     - comprimento total da antena em lambdas
    %
    % Saida:
    %   Ctx          - matriz de acoplamento MxM (complexa)

    c   = 3e8;
    lam = c / fc;
    k   = 2*pi / lam;
    eta = 120*pi;             % impedancia intrinseca do espaco livre

    % Comprimento do dipolo
    L = L_lambda * lam;
    h = L / 2;                % meia-comprimento

    % Posicoes do UCA
    angles = (0:M-1).' * (2*pi/M);
    pos_x  = R * cos(angles);
    pos_y  = R * sin(angles);

    % Constroi a matriz de acoplamento
    Ctx = eye(M);
    for i = 1:M
        for j = 1:M
            if i ~= j
                % Distancia entre elementos i e j
                d_ij = sqrt((pos_x(i)-pos_x(j))^2 + (pos_y(i)-pos_y(j))^2);

                % Impedancia mutua via metodo EMF
                Z12 = compute_Z12_emf(k, h, d_ij, eta);

                % Para monopolos: Z = Z_dipole / 2
                if strcmpi(antenna_type, 'monopole')
                    Z12 = Z12 / 2;
                end

                Ctx(i,j) = -Z12 / Z0;
            end
        end
    end
end


function Z12 = compute_Z12_emf(k, h, d, eta)
    % Impedancia mutua entre dois dipolos finos paralelos lado a lado
    % separados por distancia d, cada um com meia-comprimento h.
    %
    % Metodo: Induced EMF (Balanis Cap. 8, Jordan Cap. 11)
    % Integracao numerica por Simpson para generalidade.

    Npts = 5001;   % numero impar para Simpson 1/3
    z  = linspace(-h, h, Npts);
    dz = z(2) - z(1);

    % Corrente senoidal normalizada
    I_z = sin(k * (h - abs(z)));

    % Distancias auxiliares
    R0 = sqrt(d^2 + z.^2);
    R1 = sqrt(d^2 + (z + h).^2);
    R2 = sqrt(d^2 + (z - h).^2);

    % Kernel do campo (potencial vetorial)
    psi = exp(-1j*k*R1)./R1 + exp(-1j*k*R2)./R2 ...
        - 2*cos(k*h) * exp(-1j*k*R0)./R0;

    integrand = I_z .* psi;

    % Integracao Simpson 1/3
    n = length(integrand);
    if mod(n,2) == 0, n = n-1; end
    I_val = integrand(1) + integrand(n) ...
          + 4*sum(integrand(2:2:n-1)) ...
          + 2*sum(integrand(3:2:n-2));
    I_val = I_val * dz / 3;

    % Normaliza pela corrente maxima
    I_max = sin(k * h);
    if abs(I_max) < 1e-10
        I_max = 1;   % evita divisao por zero (dipolo full-wave)
    end

    Z12 = 1j * eta / (4 * pi * I_max^2) * I_val;
end